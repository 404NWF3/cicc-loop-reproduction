# Copy to .env.production for local Docker Compose; never commit that file.
# For Railway, set these two variables in the service's Variables panel instead.
LOOP_AUTH_USERNAME=research
# Generate a unique password of at least 16 characters (e.g. openssl rand -hex 24).
LOOP_AUTH_PASSWORD=
# Optional local port; Railway supplies its own PORT automatically.
LOOP_LOCAL_PORT=8000
