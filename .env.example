# Local historical mining works without credentials. Never commit a populated .env.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Verified 2026-10-15: deepseek-flash = DeepSeek-V4.1-Flash.
LOOP_STATE_DIR=./artifacts/runtime
LOOP_STATE_MAX_MB=64
LOOP_DATA_DIR=./data
LOOP_WORKER_AUTOSTART=true
LOOP_FIXTURE_STEP_SECONDS=0.3
LOOP_LIVE_ENABLED=true
# Paid runs require this separate demo password; never use your API key as the password.
LOOP_RESEARCH_TOKEN=
# Shared local ledger. The Docker image uses /data/deepseek.sqlite3 instead.
LOOP_BUDGET_PATH=./artifacts/budgets/deepseek.sqlite3
# Exact frontend origin(s), comma separated, for separate services only.
LOOP_CORS_ORIGINS=
# Set in the frontend BUILD environment; no trailing /api/v1.
# VITE_API_BASE_URL=https://your-backend.up.railway.app
# Frontend proxy during development; leave unset for the default local backend.
# LOOP_API_PROXY=http://127.0.0.1:8000
# Optional for local use; production always requires both credentials.
# LOOP_AUTH_USERNAME=research
# LOOP_AUTH_PASSWORD=<unique-password-at-least-16-characters>
